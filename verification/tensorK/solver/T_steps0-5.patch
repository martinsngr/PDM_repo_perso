index 0000000..cd0f310
--- /dev/null
+++ b/OpenFoamV8/solvers/hybridPorousInterFoam/tensorKFaces.H
@@ -0,0 +1,110 @@
+// Change T: k0f of a diagonal tensor K: the normal component n.K.n of each cell,
+// harmonic mean of the two cells where they differ (resistances in series; the
+// value itself where they are equal). With a diagonal K and a face normal along a
+// mesh axis the exact face flux is (n.K.n) snGrad |Sf|, so k0f is all that changes.
+{
+    const volTensorField& KT = KTensor();
+    const tensorField& KTi = KT.primitiveField();  
+
+    // Unit vector of the mesh axis of a face (exact, so that a tensor K = K0*I
+    // gives exactly K0); fatal if the face is not along an axis
+    const auto axisNormal = [](const vector& S)
+    {
+        const vector m(cmptMag(S));
+        const direction d =
+            (m.x() >= m.y() && m.x() >= m.z()) ? 0 : (m.y() >= m.z() ? 1 : 2);
+        if (m[d] < (1 - 1e-6)*mag(S))
+        {
+            FatalErrorInFunction
+                << "Tensor K needs faces along the mesh axes: Sf = " << S
+                << exit(FatalError);
+        }
+        vector n(Zero);
+        n[d] = 1;
+        return n;
+    };
+
+    forAll(KTi, celli)
+    {
+        const tensor& t = KTi[celli];
+        const scalar maxOff = max
+        (
+            max(max(mag(t.xy()), mag(t.xz())), max(mag(t.yx()), mag(t.yz()))),
+            max(mag(t.zx()), mag(t.zy()))
+        );
+        if (maxOff > 1e-6*max(max(t.xx(), t.yy()), t.zz()))
+        {
+            FatalErrorInFunction
+                << "Tensor K must be diagonal: cell " << celli << " K = " << t
+                << exit(FatalError);
+        }
+    }
+
+    // Internal faces:
+    const vectorField& Sf = mesh.Sf().primitiveField();
+    const scalarField& w = mesh.weights().primitiveField();
+    const labelUList& own = mesh.owner();
+    const labelUList& nei = mesh.neighbour();
+    forAll(k0f, facei)
+    {
+        const vector n(axisNormal(Sf[facei]));
+        const scalar KP = n & (KTi[own[facei]] & n);
+        const scalar KN = n & (KTi[nei[facei]] & n);
+        if (KP == KN)
+        {
+            k0f[facei] = KP;
+        }
+        else
+        {
+            k0f[facei] = 1/(w[facei]/KP + (1 - w[facei])/KN);
+        }
+
+        // n from axisNormal(Sf[facei]); KP, KN = n.K.n of the owner and the
+        // neighbour cell; k0f[facei] = KP where KP == KN, else the harmonic mean
+    }
+
+    // Boundary faces: 
+    forAll(k0f.boundaryField(), patchi)
+    
+    {
+        fvsPatchScalarField& k0fp = k0f.boundaryFieldRef()[patchi];
+        const fvPatchTensorField& KTp = KT.boundaryField()[patchi];
+        const vectorField& Sfp = mesh.Sf().boundaryField()[patchi];
+
+        if (KTp.coupled())  // .coupled est une fonction donc a besoin de () pour etre appeler, pas besoin de mettre true dans le if c'est implicite
+            { 
+                const tensorField KTin(KTp.patchInternalField());
+                const tensorField KTnb(KTp.patchNeighbourField());
+                const scalarField& wp = mesh.weights().boundaryField()[patchi];
+                
+                forAll(k0fp, facei)
+                {
+                    const vector n(axisNormal(Sfp[facei]));
+                    const scalar KP = n & (KTin[facei] & n);
+                    const scalar KN = n & (KTnb[facei] & n);
+                    if (KP == KN)
+                    {
+                        k0fp[facei] = wp[facei]*KP + (1 - wp[facei])*KN;  // ca donne la meme chose que KP ou KN mais c'est plus general pour les patchs couplés
+                    }
+                    else
+                    {
+                        k0fp[facei] = 1/(wp[facei]/KP + (1 - wp[facei])/KN);
+                    }
+                }
+            }
+        else 
+            {
+                forAll(k0fp,facei)
+                {
+                    const vector n(axisNormal(Sfp[facei]));
+                    k0fp[facei] = n & (KTp[facei] & n);
+                }
+            
+            }
+
+        // coupled patch (processor, cyclic): same as above, the two sides from
+        // patchInternalField() and patchNeighbourField(), the weight from
+        // mesh.weights().boundaryField()[patchi]; equal values: w*KP + (1 - w)*KN
+        // other patches: n.K.n of the boundary value
+    }
+}
