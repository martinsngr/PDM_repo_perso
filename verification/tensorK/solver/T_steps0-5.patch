+// Change T: the driving force of each phase (-grad p_phase + rho g) as a named
+// field, multiplied by the scalar mobility M (scalar K) or by kr/mu K (tensor K)
+{
+    const volVectorField forceWetting
+    (
+        "forceWetting",
+        - fvc::grad(p)
+        + (1. - alpha1)*fvc::grad(pc)
+        - pc*fvc::grad(alpha1)
+        + rho1*g
+    );
+
+    const volVectorField forceNonWetting
+    (
+        "forceNonWetting",
+        -fvc::grad(p)
+        -alpha1*fvc::grad(pc)
+        -pc*fvc::grad(alpha1)
+        +rho2*g
+    );
+
+    if (KisTensor)
+    {
+        Uwetting = Solid*(kr1/mu1)*(KTensor() & forceWetting);
+        UnonWetting = Solid*(kr2/mu2)*(KTensor() & forceNonWetting);
+    }
+    else
+    {
+        Uwetting = Solid*M1*forceWetting;
+        UnonWetting = Solid*M2*forceNonWetting;
+    }
+}
 
