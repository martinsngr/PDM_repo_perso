{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Maier et al. 2025, 1D column: 0.15 m along y (wicking upwards, gravity -y),
// 300 cells of 0.5 mm (their grid, Table 3). Only the cell size along y matters
// (empty sides); the cross-section is 0.5 x 0.5 mm. For 0.25 mm: (1 600 1).

convertToMeters 0.001;

vertices
(
    (0   0   0)
    (0.5 0   0)
    (0.5 150 0)
    (0   150 0)
    (0   0   0.5)
    (0.5 0   0.5)
    (0.5 150 0.5)
    (0   150 0.5)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (1 300 1) simpleGrading (1 1 1)
);

edges
(
);

patches
(
    patch inlet
    (
        (1 5 4 0)
    )

    patch outlet
    (
        (3 7 6 2)
    )

    empty frontAndBack
    (
        (0 4 7 3)
        (0 3 2 1)
        (2 6 5 1)
        (4 5 6 7)
    )
);

mergePatchPairs
(
);

