FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     impesFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.03;

deltaT          1e-05;

adjustTimeStep  yes;

writeControl    adjustableRunTime;

writeInterval   0.001;

purgeWrite      0;

writeFormat     ascii;

writePrecision  9;

writeCompression no;

timeFormat      general;

timePrecision   9;

runTimeModifiable yes;

CFL             Coats;

maxCo           0.5;

prefactor       0.1666;

dSmax           0.01;

maxDeltaT       0.001;

minDeltaT       1e-12;


