FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Uwetting;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    inletPad
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    sideA
    {
        type            cyclic;
    }
    sideB
    {
        type            cyclic;
    }
    bottom
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
}


