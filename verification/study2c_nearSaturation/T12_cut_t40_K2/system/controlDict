FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hybridPorousInterFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
// REV, wicking along y over 2.67 mm (outlet closed). Job 3051 (10 ms): y-yarn
// front 1.63 mm, fit 13.9 mm/sqrt(s) -> the closed end (2.67 mm) at ~31 ms.
// 50 ms (2026-10-27, 5x job 3051): the yarns reach the end and keep filling
endTime         2e-3;
deltaT          1e-8;
writeControl    adjustableRunTime;
writeInterval   1e-04;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   12;
runTimeModifiable yes;

// Time step: solver limits on the total flux (free cells), then the
// coatsTimeStep function object (porous cells + capillary waves) overwrites
// maxDeltaT every step; setDeltaT.H grows dt by at most 1.2x per step.
// Values as ../../trialWicking/singleYarn_vertical_hybrid.
adjustTimeStep  yes;
maxCo           0.75;
maxAlphaCo      1;
maxDeltaT       3e-8;   // first-step cap only
CoatsMaxCo      0.5;
dSmax           0.01;
maxDeltaTCoats  1e-3;
minDeltaTCoats  0;
CapillaryMaxCo  0.5;

// Stop guard (../../tools/stopGuard): write and end after maxSteps steps
// (-1: no limit) or when deltaT < minDeltaTStop (collapsed time step).
maxSteps        -1;
minDeltaTStop   1e-14;

functions
{
    coatsTimeStep { #include "../../tools/coatsTimeStep" }
    liquidBalance { #include "../../tools/liquidBalance" }
    stopGuard     { #include "../../tools/stopGuard" }
    waterBudget   { #include "../../tools/waterBudget" }
    dsLocator     { #include "../../tools/dsLocator" }
}

