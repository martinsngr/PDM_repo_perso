--- a/OpenFoamV8/solvers/hybridPorousInterFoam/updateVariables.H (of9-port be1a3ab)
+++ b/OpenFoamV8/solvers/hybridPorousInterFoam/updateVariables.H (study2c variant G2b)
@@ -60,6 +60,40 @@
 {
     pc *= Solid;
     dPcdS *= Solid;
+
+    // Study 2c variant G2b (verification/study2c_nearSaturation, scratch build
+    // only): free cells with an interface carry the VOF capillary pressure
+    // pc = -w(alpha)*sigma*K (K = -div(nHat), p_water - p_air = sigma*K), in the
+    // same mixture form as the porous cells (p = p_air - alpha*pc): the
+    // porous/free Darcy faces then use the air and water pressures of the free
+    // cell instead of its VOF pressure for both. Weight w = 0 below alphaMin and
+    // above 1 - alphaMin, 1 between alphaMin + ramp and 1 - alphaMin - ramp
+    // (linear ramps): in cells holding a trace of one phase the curvature is
+    // meaningless (G2 with a sharp band at 1e-3 pulled water out of wet yarn
+    // cells). Keywords porousFreeVofPc (default off: solver unchanged),
+    // porousFreeVofPcAlphaMin (0.05), porousFreeVofPcAlphaRamp (0.1).
+    if (transportProperties.lookupOrDefault<Switch>("porousFreeVofPc", false))
+    {
+        const scalar aMin =
+            transportProperties.lookupOrDefault<scalar>
+            (
+                "porousFreeVofPcAlphaMin",
+                0.05
+            );
+        const scalar aRamp =
+            transportProperties.lookupOrDefault<scalar>
+            (
+                "porousFreeVofPcAlphaRamp",
+                0.1
+            );
+        const volScalarField w
+        (
+            (1. - Solid)
+           *min(max((alpha1 - aMin)/aRamp, scalar(0)), scalar(1))
+           *min(max((1. - aMin - alpha1)/aRamp, scalar(0)), scalar(1))
+        );
+        pc -= w*mixture.sigmaK();
+    }
 }
 PcCoeff = (  
 	-pc
