@@ -21,6 +21,51 @@
 kr2f = (1. - porousFace)*kr2f
   + porousFace*upwind<scalar>(mesh, phiNonWettingUp).interpolate(kr2);
 
+// Study 2c variant K1 (verification/study2c_nearSaturation, scratch build only):
+// on porous/free Darcy faces (porousFace 1, Solidf 0) both kr from the porous
+// cell instead of the upstream cell of each phase (C): air entering a yarn from
+// a gap cell gets the yarn's air mobility, not the one of the gap cell's VOF
+// alpha. Keyword porousFreeKrPorous (default off: solver unchanged).
+if (transportProperties.lookupOrDefault<Switch>("porousFreeKrPorous", false))
+{
+    const labelUList& own = mesh.owner();
+    const labelUList& nei = mesh.neighbour();
+    forAll(nei, facei)
+    {
+        if (porousFace[facei] > 0.5 && Solidf[facei] < 0.5)
+        {
+            const label c = Solid[own[facei]] > 0.5 ? own[facei] : nei[facei];
+            kr1f[facei] = kr1[c];
+            kr2f[facei] = kr2[c];
+        }
+    }
+    forAll(kr1f.boundaryField(), patchi)
+    {
+        if (!mesh.boundary()[patchi].coupled())
+        {
+            continue;
+        }
+        const fvsPatchScalarField& pfp = porousFace.boundaryField()[patchi];
+        const fvsPatchScalarField& sfp = Solidf.boundaryField()[patchi];
+        const scalarField SolidI(Solid.boundaryField()[patchi].patchInternalField());
+        const scalarField kr1I(kr1.boundaryField()[patchi].patchInternalField());
+        const scalarField kr1N(kr1.boundaryField()[patchi].patchNeighbourField());
+        const scalarField kr2I(kr2.boundaryField()[patchi].patchInternalField());
+        const scalarField kr2N(kr2.boundaryField()[patchi].patchNeighbourField());
+        fvsPatchScalarField& k1 = kr1f.boundaryFieldRef()[patchi];
+        fvsPatchScalarField& k2 = kr2f.boundaryFieldRef()[patchi];
+        forAll(pfp, i)
+        {
+            if (pfp[i] > 0.5 && sfp[i] < 0.5)
+            {
+                const bool inPorous = SolidI[i] > 0.5;
+                k1[i] = inPorous ? kr1I[i] : kr1N[i];
+                k2[i] = inPorous ? kr2I[i] : kr2N[i];
+            }
+        }
+    }
+}
