@@ -60,6 +60,29 @@
 {
     pc *= Solid;
     dPcdS *= Solid;
+
+    // Study 2c variant G2 (verification/study2c_nearSaturation, scratch build
+    // only): free cells inside the interface band (alphaMin < alpha <
+    // 1 - alphaMin) carry the VOF capillary pressure pc = -sigma*K (K =
+    // -div(nHat), p_water - p_air = sigma*K), in the same mixture form as the
+    // porous cells (p = p_air - alpha*pc): the porous/free Darcy faces then use
+    // the air and water pressures of the free cell instead of its VOF
+    // pressure for both. Keyword porousFreeVofPc (default off: solver
+    // unchanged), porousFreeVofPcAlphaMin (default 1e-3).
+    if (transportProperties.lookupOrDefault<Switch>("porousFreeVofPc", false))
+    {
+        const scalar aMin =
+            transportProperties.lookupOrDefault<scalar>
+            (
+                "porousFreeVofPcAlphaMin",
+                1e-3
+            );
+        const volScalarField band
+        (
+            (1. - Solid)*pos(alpha1 - aMin)*pos(1. - aMin - alpha1)
+        );
+        pc -= band*mixture.sigmaK();
+    }
 }
