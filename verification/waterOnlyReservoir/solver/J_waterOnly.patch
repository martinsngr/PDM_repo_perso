+// Change J (opt-in waterOnlyPatches (<patch names>) in transportProperties):
+// reservoir patches that exchange water only, as the surface of a bath. On
+// their porous faces the air mobility is zero (updateVariables.H), so the
+// pressure equation carries the water Darcy flux only; on all their faces
+// the alpha flux is the total flux (alphaEqn.H); their free faces are closed
+// (zero flux) while the cell next to them is air-rich, alpha < 0.5, and open
+// both ways while it holds water (pEqn.H). No air enters or leaves through
+// them. The reservoir water pressure comes from the p boundary condition.
+// Without the keyword the solver is unchanged.
+const labelHashSet waterOnlyPatchIDs
+(
+    mesh.boundaryMesh().patchSet
+    (
+        transportProperties.lookupOrDefault<wordReList>
+        (
+            "waterOnlyPatches",
+            wordReList()
+        )
+    )
+);
+forAllConstIter(labelHashSet, waterOnlyPatchIDs, iter)
+{
+    if (mesh.boundaryMesh()[iter.key()].coupled())
+    {
+        FatalErrorInFunction
+            << "waterOnlyPatches: " << mesh.boundaryMesh()[iter.key()].name()
+            << " is a coupled patch" << exit(FatalError);
+    }
+    Info<< "waterOnlyPatches: " << mesh.boundaryMesh()[iter.key()].name()
+        << " exchanges water only (no air through it)" << endl;
+}
+
 // Change G (opt-in): porous/free faces carry the porous two-phase fluxes,
