+// Change M1 (scratch, study2f_horizontalAir): on porous/free Darcy faces the air
+// kr times the air fraction of the free cell (1 - alpha): air crosses the yarn
+// surface only where the free side is air (no air into water, no air out of water)
+if (porousFreeAirFraction)
+{
+    const labelUList& own = mesh.owner();
+    const labelUList& nei = mesh.neighbour();
+    forAll(nei, facei)
+    {
+        if (porousFace[facei] > 0.5 && Solidf[facei] < 0.5)
+        {
+            // the free cell of the face (the other one is the porous cell)
+            const label cf = Solid[own[facei]] > 0.5 ? nei[facei] : own[facei];
+            kr2f[facei] *= max(1. - alpha1[cf], 0.);
+        }
+    }
+    forAll(kr2f.boundaryField(), patchi)
+    {
+        if (!mesh.boundary()[patchi].coupled())
+        {
+            continue;
+        }
+        const fvsPatchScalarField& pfp = porousFace.boundaryField()[patchi];
+        const fvsPatchScalarField& sfp = Solidf.boundaryField()[patchi];
+        const scalarField SolidI(Solid.boundaryField()[patchi].patchInternalField());
+        const scalarField aI(alpha1.boundaryField()[patchi].patchInternalField());
+        const scalarField aN(alpha1.boundaryField()[patchi].patchNeighbourField());
+        fvsPatchScalarField& k2 = kr2f.boundaryFieldRef()[patchi];
+        forAll(pfp, i)
+        {
+            if (pfp[i] > 0.5 && sfp[i] < 0.5)
+            {
+                // alpha of the free side: the neighbour if this side is porous
+                const scalar af = SolidI[i] > 0.5 ? aN[i] : aI[i];
+                k2[i] *= max(1. - af, 0.);
+            }
+        }
+    }
+}
