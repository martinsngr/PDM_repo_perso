#!/bin/bash
cd "${0%/*}" || exit 1
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# REV of the plain-weave fabric, wicking along y: from the TexGen geometry to the
# initial fields. Overwrites the mesh and 0/; then ./run. Setup decisions:
# ../../NOTES_cases.md, REV case status (2026-10-26). Python: $PY, else the repo
# .venv (numpy, trimesh).
#
#   geometry   Textiles/PW-22-15-0.4-0.5.stl (TexGen, funge.py), copy in
#              constant/triSurface/; REV box in rev_domain.json (inspect_stl.py,
#              rerun only if the STL changes: python inspect_stl.py <stl> 0.01)
#   mesh       uniform 20 um hex mesh by build_fields.py: the REV box (91 x 133
#              x 14 cells) plus 3 free cell layers below and above it (--zpad 3,
#              same cells in the box as without padding). Patches: inlet = y min
#              of the box (reservoir), inletPad = y min of the padding (closed),
#              outlet = y max (closed: end of the sample), sideA/sideB = cyclic
#              in x, bottom/top = z faces of the padding (open to air)
#   fields     eps, K (scalar 1e-11 in the yarns, binary cut cells), fYarn,
#              yarnID by build_fields.py; alpha.wetting by ../tools/initFields.py
#              yarns saturated (0.99) over the first 0.1 mm (--sat-height), then
#              the 0.2 mm ramp to dry (0.002), free cells pure air except a 0.1 mm
#              water column in the free cells of the box at the inlet (padding dry):
#              the most stable start of the 2026-10-26 smoke tests (NOTES_cases.md)
#   BCs        0.orig: inlet = bath, top/bottom = air, both at rest at 0 Pa (p
#              totalPressure); outlet and inletPad closed walls. alpha.wetting
#              (initFields.py): water enters through the inlet at alpha 1, also
#              on the yarn faces (--porous-in 1: saturated by the bath, so p = 0
#              there is the bath water pressure); air through top/bottom

PY=${PY:-../../.venv/bin/python}
[ -x "$PY" ] || PY=python3

./clean
rm -rf constant/polyMesh 0 system/blockMeshDict
cp -r 0.orig 0
rm -f log.blockMesh log.checkMesh log.build_fields log.postProcess.writeCellCentres log.initFields

"$PY" build_fields.py . --k-mode scalar --k-scalar 1e-11 --cut-cells binary --wick-axis y --zpad 3 \
    > log.build_fields 2>&1 || { cat log.build_fields; exit 1; }
runApplication blockMesh
runApplication checkMesh
runApplication -s writeCellCentres postProcess -func writeCellCentres -time 0
"$PY" ../tools/initFields.py --closed-patch outlet --closed-patch inletPad --free-fill 1e-4 --sat-height 1e-4 --porous-in 1 \
    > log.initFields 2>&1 || { cat log.initFields; exit 1; }
cat log.initFields
rm -f 0/C 0/Cx 0/Cy 0/Cz
