#!/bin/bash
cd "${0%/*}" || exit 1
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# REV of the plain-weave fabric, from the TexGen geometry to the initial fields.
# Overwrites the mesh and 0/; then the solver run (not written yet, see
# ../NOTES.md "Next steps"). Python: $PY, else the repo .venv (numpy, trimesh).
#
#   geometry   Textiles/PW-22-15-0.4-0.5.stl (TexGen, funge.py), copy in
#              constant/triSurface/; REV box in rev_domain.json (inspect_stl.py,
#              rerun only if the STL changes: python inspect_stl.py <stl> 0.01)
#   mesh       uniform hex mesh written by build_fields.py (system/blockMeshDict)
#   fields     eps, K (scalar 1e-11 in the yarns, binary cut cells), fYarn,
#              yarnID by build_fields.py; alpha.wetting by ../tools/initFields.py
#              (yarns dry with the 0.2 mm wetted ramp at the inlet, gaps pure air)
#
# Open setup decisions for the REV (../NOTES.md): top/bottom open porous faces
# (unstable in the 2D tests: close or pad with --zgap), water column in the gaps
# at the inlet (initFields.py --free-fill), H/F'/I keywords and contact angle
# in constant/transportProperties (as ../2D_bench).

PY=${PY:-../../.venv/bin/python}
[ -x "$PY" ] || PY=python3

./clean
rm -rf constant/polyMesh 0 system/blockMeshDict
cp -r 0.orig 0
rm -f log.blockMesh log.checkMesh log.build_fields log.postProcess.writeCellCentres log.initFields

"$PY" build_fields.py . --k-mode scalar --k-scalar 1e-11 --cut-cells binary > log.build_fields 2>&1 \
    || { cat log.build_fields; exit 1; }
runApplication blockMesh
runApplication checkMesh
runApplication -s writeCellCentres postProcess -func writeCellCentres -time 0
"$PY" ../tools/initFields.py > log.initFields 2>&1 || { cat log.initFields; exit 1; }
cat log.initFields
rm -f 0/C 0/Cx 0/Cy 0/Cz
