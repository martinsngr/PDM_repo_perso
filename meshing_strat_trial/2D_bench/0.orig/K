FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// permeability [m2]: free fluid 1 (K_VOID of ../build_fields.py), yarn 1e-11 (system/setFieldsDict)
// Uniform here; ./Allpre copies 0.orig to 0 and setFields writes the per-cell values there.

dimensions      [0 2 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    "(inlet|outlet|top|bottom)"
    {
        type            zeroGradient;
    }
}

