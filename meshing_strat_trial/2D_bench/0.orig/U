FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Total velocity. Open patches: inflow from the normal flux, outflow
// zeroGradient (as the 1D inlet).

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    "(inlet|outlet)"
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    "(top|bottom)"      // closed walls behind the yarn walls
    {
        type noSlip;
    }
}

