FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D bench (x-z plane, one cell in y): 1.0 x 0.3 mm, 20 um cells as the REV.
// Wicking along x (gravity -x, constant/g), reservoir on inlet (x = 0).
// Porous slab z 0.06-0.22 mm (system/setFieldsDict) between two free layers
// (3 and 4 cells), i.e. a yarn wetted from its end with porous/free faces
// along its whole length, as the yarns of the REV next to the gaps.
// Patch names and BCs as REV_hybrid: inlet, outlet, bottom, top open.

convertToMeters 1e-3;

vertices
(
    (0   0    0  )
    (1.0 0    0  )
    (1.0 0.02 0  )
    (0   0.02 0  )
    (0   0    0.3)
    (1.0 0    0.3)
    (1.0 0.02 0.3)
    (0   0.02 0.3)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 1 15) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((2 6 5 1));
    }
    bottom
    {
        type patch;
        faces ((0 3 2 1));
    }
    top
    {
        type patch;
        faces ((4 5 6 7));
    }
    frontAndBack
    {
        type empty;
        faces ((1 5 4 0) (3 7 6 2));
    }
);

