FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      UnonWetting;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Darcy velocity of the air, recomputed by the solver from p and alpha every
// step (0 in the gaps): output only. Not fixedValue on an open patch: there
// correctUBc.H would replace the face flux by (Uwetting + UnonWetting).Sf.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    ".*"
    {
        type            zeroGradient;
    }
}

