FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      eps;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// porosity: free fluid 1, yarn 0.5 (system/setFieldsDict)
// Uniform here; ./Allpre copies 0.orig to 0 and setFields writes the per-cell values there.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    "(inlet|outlet)"
    {
        type            zeroGradient;
    }
    "(top|bottom)"      // closed walls behind the yarn walls
    {
        type zeroGradient;
    }
}

