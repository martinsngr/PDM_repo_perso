FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D bench (x-z plane, one cell in y), thick-wall slit: porous yarn wall |
// free gap | porous yarn wall, 2.0 x 0.48 mm, 20 um cells as the REV
// (100 x 24 cells). Across z: wall 8 cells (0-0.16 mm) | gap 8 cells
// (0.16-0.32 mm) | wall 8 cells (0.32-0.48 mm); walls of 8 cells = half a REV
// yarn width (../../NOTES_cases.md, REV geometry), closed behind (top, bottom).
// Wicking along x (gravity -x, constant/g): reservoir on inlet (x = 0), open
// to air on outlet (x = 2 mm). Walls set by system/setFieldsDict.
// Identical to slit_test/makeSlit.py --walls porous --nw 8 --w 8 (same
// coordinates, so results can be compared bit for bit).

convertToMeters 1;

vertices
(
    (0 0 0) (0.002 0 0) (0.002 2e-05 0) (0 2e-05 0)
    (0 0 0.00048) (0.002 0 0.00048) (0.002 2e-05 0.00048) (0 2e-05 0.00048)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (100 1 24) simpleGrading (1 1 1)
);

boundary
(
    inlet           // reservoir
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet          // open to air
    {
        type patch;
        faces ((2 6 5 1));
    }
    bottom          // closed wall behind the lower yarn wall
    {
        type patch;
        faces ((0 3 2 1));
    }
    top             // closed wall behind the upper yarn wall
    {
        type patch;
        faces ((4 5 6 7));
    }
    frontAndBack
    {
        type empty;
        faces ((1 5 4 0) (3 7 6 2));
    }
);

