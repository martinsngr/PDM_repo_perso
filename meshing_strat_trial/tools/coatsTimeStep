/*--------------------------------*- C++ -*----------------------------------*\
  Shared adaptive time-step function object, included in system/controlDict:
      functions { coatsTimeStep { #include "../../tools/coatsTimeStep" } }

  From ../trialWicking/singleYarn_vertical_hybrid (impesFoam's CFL Coats and
  dSmax, Brooks-Corey kr / Van Genuchten pc), with two changes for meshes
  that mix porous and free cells:
    1. Coats CFL and dSmax are evaluated in porous cells only (Solid = 1),
       and the capillary sum K*A/d over porous faces only (both cells
       porous). Free cells carry K_VOID = 1 m2, which would make the
       capillary term, and so dt, meaningless there. In free cells the
       solver's own limits (maxCo, maxAlphaCo of setDeltaT.H) apply.
    2. Capillary-wave limit of the free surface (Brackbill et al. 1992),
       dt < CapillaryMaxCo*sqrt(rho_avg*dx^3/(2*pi*sigma)), dx = smallest
       cell, if the mesh has free cells. setDeltaT.H does not apply it.
  Reads from controlDict: CoatsMaxCo (0.5), dSmax (0.01), maxDeltaTCoats
  (1e-3), minDeltaTCoats (0), CapillaryMaxCo (0.5). Overwrites maxDeltaT in
  memory each step; setDeltaT.H then grows dt by at most 1.2x per step.
\*---------------------------------------------------------------------------*/

type            coded;
libs            ("libutilityFunctionObjects.so");
name            coatsTimeStep;
executeControl  timeStep;
writeControl    none;
codeInclude
#{
    #include "fvc.H"
    #include "uniformDimensionedFields.H"
    #include "mathematicalConstants.H"
#};
codeExecute
#{
    const Time& runTime = mesh().time();
    const dictionary& cd = runTime.controlDict();
    const scalar coatsMax = cd.lookupOrDefault<scalar>("CoatsMaxCo", 0.5);
    const scalar dSmax = cd.lookupOrDefault<scalar>("dSmax", 0.01);
    const scalar dtMax = cd.lookupOrDefault<scalar>("maxDeltaTCoats", 1e-3);
    const scalar dtMin = cd.lookupOrDefault<scalar>("minDeltaTCoats", 0);
    const scalar capMax = cd.lookupOrDefault<scalar>("CapillaryMaxCo", 0.5);
    const volScalarField& alpha =
        mesh().lookupObject<volScalarField>("alpha.wetting");
    const volScalarField& eps =
        mesh().lookupObject<volScalarField>("eps");
    const volScalarField& K =
        mesh().lookupObject<volScalarField>("K");
    const volScalarField& Solid =
        mesh().lookupObject<volScalarField>("Solid");
    const surfaceScalarField& phi =
        mesh().lookupObject<surfaceScalarField>("phi");
    const uniformDimensionedVectorField& g =
        mesh().lookupObject<uniformDimensionedVectorField>("g");
    const dictionary& tp =
        mesh().lookupObject<IOdictionary>("transportProperties");
    const dictionary& wet = tp.subDict("wetting");
    const dictionary& non = tp.subDict("nonWetting");
    const scalar rhob = dimensionedScalar("rho", dimDensity, wet).value();
    const scalar rhoa = dimensionedScalar("rho", dimDensity, non).value();
    const scalar mub =
        rhob*dimensionedScalar("nu", dimViscosity, wet).value();
    const scalar mua =
        rhoa*dimensionedScalar("nu", dimViscosity, non).value();
    const scalar Mmu = mub/mua;
    const scalar act = readScalar(tp.lookup("activateCapillarity"));
    const scalar Smin =
        dimensionedScalar(tp.lookup("alpha.wettingmin")).value();
    const scalar Smax =
        dimensionedScalar(tp.lookup("alpha.wettingmax")).value();
    const scalar nkr =
        readScalar(tp.subDict("BrooksAndCoreyCoeffs").lookup("n"));
    const dictionary& vg = tp.subDict("VanGenuchtenCoeffs");
    const scalar pc0 = dimensionedScalar(vg.lookup("pc0")).value();
    const scalar m = readScalar(vg.lookup("m"));
    const scalar Sminpc =
        dimensionedScalar(vg.lookup("alpha.wettingminpc")).value();
    const scalar Smaxpc =
        dimensionedScalar(vg.lookup("alpha.wettingmaxpc")).value();
    const scalar nvg = 1/(1 - m);

    // porous faces: both neighbours porous (as Solidf in the solver)
    surfaceScalarField porousf(fvc::interpolate(Solid));
    porousf = pos0(porousf - (1 - small));
    const scalarField sumKA
    (
        fvc::surfaceSum
        (
            porousf*fvc::interpolate(K)*mesh().magSf()/mag(mesh().delta())
        )().primitiveField()
    );
    const scalarField sumPhi
    (
        fvc::surfaceSum(mag(phi))().primitiveField()
    );
    const scalarField sumSfg
    (
        fvc::surfaceSum(mag(mesh().Sf() & g))().primitiveField()
    );
    const scalar dt = runTime.deltaTValue();
    const scalarField& V = mesh().V();
    scalar CFLmax = 0;
    scalar dSdtMax = 0;
    label nFree = 0;
    forAll(V, i)
    {
        if (Solid[i] < 0.5)
        {
            nFree++;
            continue;
        }
        const scalar Se =
            min(max((alpha[i] - Smin)/(Smax - Smin), 1e-4), 1 - 1e-4);
        const scalar kra = pow(1 - Se, nkr);
        const scalar krb = pow(Se, nkr);
        const scalar dkra = -nkr*pow(1 - Se, nkr - 1)/(Smax - Smin);
        const scalar dkrb = nkr*pow(Se, nkr - 1)/(Smax - Smin);
        const scalar den = Mmu*sqr(kra) + 2*kra*krb + sqr(krb)/Mmu;
        const scalar Sepc =
            min
            (
                max((alpha[i] - Sminpc)/(Smaxpc - Sminpc), 1e-4),
                1 - 1e-4
            );
        const scalar dpcdS =
            act*(1/(nvg*m))*(pc0/(Smaxpc - Sminpc))
           *pow(pow(Sepc, -1/m) - 1, 1/nvg - 1)*pow(Sepc, -(1 + m)/m);
        // flow, gravity and capillary parts of the Coats CFL
        const scalar CFL =
            (dt/eps[i])
           *(
                (dkrb*kra - dkra*krb)/den*sumPhi[i]
              - K[i]*(rhoa - rhob)*sumSfg[i]
               *(sqr(kra)*dkrb/mua + sqr(krb)*dkra/mub)/den
              + 2*dpcdS*sumKA[i]*kra*krb/(mub*kra + mua*krb)
            )/V[i];
        CFLmax = max(CFLmax, CFL);
        dSdtMax =
            max(dSdtMax, mag(alpha[i] - alpha.oldTime()[i])/dt);
    }
    reduce(CFLmax, maxOp<scalar>());
    reduce(dSdtMax, maxOp<scalar>());
    reduce(nFree, sumOp<label>());
    const scalar dtCoats = dt*coatsMax/(CFLmax + small);
    const scalar dtForS = dSmax/(dSdtMax + small);
    scalar dtCap = great;
    const scalar sigma =
        dimensionedScalar("sigma", dimMass/sqr(dimTime), tp).value();
    // no capillary-wave limit without free cells or with sigma 0 (also
    // avoids a division by zero, trapped as SIGFPE)
    if (nFree > 0 && sigma > 0)
    {
        const scalar dx = cbrt(gMin(V));
        dtCap =
            capMax
           *sqrt(0.5*(rhoa + rhob)*pow3(dx)/(constant::mathematical::twoPi*sigma));
    }
    const scalar limit =
        max(min(min(min(dtCoats, dtForS), dtCap), dtMax), dtMin);
    const_cast<dictionary&>(cd).set("maxDeltaT", limit);
    Info<< "Coats CFL Number max: " << CFLmax
        << "  dtCoats = " << dtCoats << "  dtdS = " << dtForS
        << "  dtCap = " << dtCap
        << "  maxDeltaT = " << limit << endl;
#};

