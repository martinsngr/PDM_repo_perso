/*--------------------------------*- C++ -*----------------------------------*\
  Shared p (mixture pressure) BC for the patches open to air or to the
  reservoir. Used from 0/p of the cases as
      "(inlet|outlet|top|bottom)" { #include "../../tools/pOpenAir" }
  (one library, compiled once, for all patches).

  p is the mixture pressure p_air - alpha*pc(alpha) (updateDarcyVelocities.H,
  PcCoeff). On every face:
    - free-fluid face (eps > 0.99): p = 0 (air, or reservoir water, at 0 Pa);
      with openFreeTotalPressure 1 (transportProperties, default 0): total
      pressure 0 on inflow faces, p = -0.5*rho*|U|^2 (fluid at rest outside,
      as a reservoir; the static p = 0 inlet gives the entering water its
      velocity for free, ../../NOTES_cases.md "Slit tests"), p = 0 on outflow faces
    - porous face (eps <= 0.99), switch openPorousAirZero in
      constant/transportProperties:
        1 (default): air at 0 Pa, p = -alpha*pc(alpha), as the 1D and single
          yarn cases (../trialWicking/1D_vertical_hybrid)
        0: mixture at 0 Pa, p = 0, i.e. the value the solver itself reaches
          across an interior porous/free face (mixture p continuous there)
  pc: Van Genuchten with the solver's Se clipping (pcVanGenuchten.H).
\*---------------------------------------------------------------------------*/

type            codedFixedValue;
value           uniform 0;
name            pOpenAir;
code
#{
    const fvPatchScalarField& alphap =
        patch().lookupPatchField<volScalarField, scalar>("alpha.wetting");
    const fvPatchScalarField& epsp =
        patch().lookupPatchField<volScalarField, scalar>("eps");
    const dictionary& tp =
        db().lookupObject<IOdictionary>("transportProperties");
    const scalar airZero =
        tp.lookupOrDefault<scalar>("openPorousAirZero", 1);
    const scalar freeTotal =
        tp.lookupOrDefault<scalar>("openFreeTotalPressure", 0);
    const fvPatchVectorField& Up =
        patch().lookupPatchField<volVectorField, vector>("U");
    const fvsPatchScalarField& phip =
        patch().lookupPatchField<surfaceScalarField, scalar>("phi");
    const fvPatchScalarField& rhop =
        patch().lookupPatchField<volScalarField, scalar>("rho");
    const dictionary& vg = tp.subDict("VanGenuchtenCoeffs");
    const scalar act  = readScalar(tp.lookup("activateCapillarity"));
    const scalar pc0  = dimensionedScalar(vg.lookup("pc0")).value();
    const scalar m    = readScalar(vg.lookup("m"));
    const scalar Smin =
        dimensionedScalar(vg.lookup("alpha.wettingminpc")).value();
    const scalar Smax =
        dimensionedScalar(vg.lookup("alpha.wettingmaxpc")).value();
    const scalar n    = 1/(1 - m);
    scalarField pb(alphap.size(), 0);
    forAll(pb, i)
    {
        if (epsp[i] <= 0.99)
        {
            const scalar Se =
                min(max((alphap[i] - Smin)/(Smax - Smin), 1e-4), 1 - 1e-4);
            const scalar pc = act*pc0*pow(pow(Se, -1/m) - 1, 1/n);
            pb[i] = -airZero*alphap[i]*pc;
        }
        else if (freeTotal > 0 && phip[i] < 0)
        {
            pb[i] = -0.5*rhop[i]*magSqr(Up[i]);
        }
    }
    operator==(pb);
#};

