dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
    }
    outlet
    {
        type            calculated;
    }
    bottom
    {
        type            symmetry;
    }
    top
    {
        type            symmetry;
    }
    left
    {
        type            symmetry;
    }
    right
    {
        type            symmetry;
    }
    PW-22-15-0.4-0.5
    {
        type            calculated;
    }
}


