# Python
__pycache__/
*.pyc
.venv/

# OS / editor cruft (WSL "Zone.Identifier" marks on files copied from Windows)
*.Identifier

# OpenFOAM case outputs — regenerated by AllRun.sh / AllClean, never push these
dynamicCode/
postProcessing/
processor[0-9]*/
log.*
log[0-9]*.*
AllRun.log
# SLURM job output (job.slurm: Log_%x_%j.log, Err_%x_%j.err)
Log_*.log
Err_*.err
**/constant/polyMesh/
**/constant/*/polyMesh/
**/constant/polyMesh_full/
**/cellToRegion
**/0/fluid/
**/0/yarn/

# OpenFOAM time-step result directories (numeric names), initial conditions in 0/ are kept
[1-9]*/
0.*/
# ...but case folders named 1D_* / 2D_* and 0.orig (source initial fields) are not time directories
!1D*/
!2D*/
!0.orig/

# Run output and generated fields
run.out
*.OpenFOAM
**/0/Sb

# ---------------------------------------------------------------------------------------------------------
# Folder rules (2026-10-26: merged here from meshing_strat_trial/.gitignore, verification/.gitignore and
# verification/solver_failures/.gitignore, so that this file is the only .gitignore of the repo)

# meshing_strat_trial/: generated by the case scripts (./Allpre, ./run, makeVariant.sh): rebuild instead of
# committing (logs, dynamicCode, postProcessing, processor*, polyMesh and time folders: rules above)
meshing_strat_trial/2D_bench/0/
meshing_strat_trial/2D_bench/check_summary.md
meshing_strat_trial/2D_bench/check.png
meshing_strat_trial/2D_bench_strip/0/
meshing_strat_trial/REV/0/
meshing_strat_trial/REV/system/blockMeshDict
meshing_strat_trial/*/liquidBalance.csv
# bench variant runs (results); the scripts in variants/ are tracked
meshing_strat_trial/2D_bench_strip/variants/*_*/
meshing_strat_trial/2D_bench_strip/variants/.makeVariant_frozen.sh
# slit test runs (results, makeSlit.py); the scripts and figures/ are tracked
meshing_strat_trial/slit_test/S*_*/
meshing_strat_trial/slit_test/D_*/
meshing_strat_trial/slit_test/__pycache__/
meshing_strat_trial/slit_test/old_runs/*
!meshing_strat_trial/slit_test/old_runs/README.md
meshing_strat_trial/slit_test/.makeSlit_run.py
meshing_strat_trial/slit_test/IF_*/
# thick-wall bench runs (2026-10-13: B_ installed solver, H_/HF_/I_/J_/N_/P_ scratch changes, R_/V_ regression)
meshing_strat_trial/slit_test/[BHIJNPRV]_*/
meshing_strat_trial/slit_test/HF_*/

# verification/: run results (regenerated by each study's runs and scripts, see its README.md); the
# liquidBalance.csv files of verification/wicking1D/ were committed before this rule and stay tracked
verification/**/liquidBalance.csv
verification/**/waterBudget.csv
verification/**/check.png
verification/**/check_summary.md
# copies of the original runs behind each solver change (results)
verification/solver_failures/**/cases/

# solver logs of cluster runs during the run (LOG_DIR=logs, runTools.sh)
meshing_strat_trial/REV/logs/

# run outputs
meshing_strat_trial/*/waterBudget.csv
**/system/fluid/
