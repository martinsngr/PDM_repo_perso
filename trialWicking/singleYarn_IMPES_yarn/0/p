FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    yarn_to_fluid
    {
        type            fixedValue;
        value           uniform 0;
    }
    
    wetInlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    bottom
    {
        type            symmetry;
    }

    top
    {
        type            symmetry;
    }

    left
    {
        type            symmetry;
    }

    right
    {
        type            symmetry;
    }
}

