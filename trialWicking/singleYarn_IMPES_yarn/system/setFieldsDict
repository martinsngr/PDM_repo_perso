FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../caseSetup"
defaultFieldValues
(
    volScalarFieldValue Sb 2e-3
    volScalarFieldValue Winj 0
    volScalarFieldValue Wext 0
);

regions
(
    boxToCell
    {
        box ($xmin $ymin $zmin) ($xmax $ymax $zWater);

        fieldValues
        (
            volScalarFieldValue Sb 0.2
        );
    }
);

