FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../caseSetup"

actions
(
    {
        name    wetInletFaces;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo
        {
            name yarn_to_fluid;
        }
    }

    {
        name    wetInletFaces;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box ($xmin $ymin $zmin) ($xmax $ymax $zWater);
        }
    }
);