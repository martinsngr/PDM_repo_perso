FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.wetting;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// initial saturation as in ../1D_vertical_impes
internalField   uniform 0.002;

boundaryField
{
    // imposed saturation at the wetted face (replaces the impesFoam reservoir
    // clamped at Sb 0.99)
    inlet
    {
        type            fixedValue;
        value           uniform 0.99;
    }
    // as the impesFoam outlet (Sb fixed 1e-3)
    outlet
    {
        type            fixedValue;
        value           uniform 0.001;
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //
