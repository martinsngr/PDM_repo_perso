FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// p is the saturation-weighted mixture pressure
//     p = alpha*p_wetting + (1 - alpha)*p_nonWetting = p_nonWetting - alpha*pc(alpha)
// (see updateDarcyVelocities.H / PcCoeff in the solver). The air pressure is
// 0 at both ends, as in impesFoam, so both patches compute
//     p = -alpha_face*pc(alpha_face)
// every time step (codedFixedValue), with the Van Genuchten pc of
// constant/transportProperties and the solver's Se clipping [1e-4, 1-1e-4].
// The pc parameters are read from transportProperties, so nothing needs
// recomputing if they change. At the inlet alpha is 0.99 (p = -669 Pa); at
// the outlet alpha is zeroGradient, so p follows the top cell: -4995 Pa while
// it is dry (alpha 0.002), -3908 Pa at 0.055 s. A fixed -4995 Pa would put
// the air at the top ~1.2 kPa below 0 once the front arrives (~0.035 s).
// The code is compiled into dynamicCode/ on the first run.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform -4995;

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform -669;
        name            airPressureZeroInlet;

        code
        #{
            // p (mixture) = p_air - alpha*pc(alpha), with p_air = 0
            const fvPatchScalarField& alphap =
                patch().lookupPatchField<volScalarField, scalar>("alpha.wetting");

            const dictionary& tp =
                db().lookupObject<IOdictionary>("transportProperties");
            const dictionary& vg = tp.subDict("VanGenuchtenCoeffs");

            const scalar act  = readScalar(tp.lookup("activateCapillarity"));
            const scalar pc0  = dimensionedScalar(vg.lookup("pc0")).value();
            const scalar m    = readScalar(vg.lookup("m"));
            const scalar Smin =
                dimensionedScalar(vg.lookup("alpha.wettingminpc")).value();
            const scalar Smax =
                dimensionedScalar(vg.lookup("alpha.wettingmaxpc")).value();
            const scalar n    = 1/(1 - m);

            scalarField pb(alphap.size());
            forAll(pb, i)
            {
                const scalar Se =
                    min(max((alphap[i] - Smin)/(Smax - Smin), 1e-4), 1 - 1e-4);
                const scalar pc = act*pc0*pow(pow(Se, -1/m) - 1, 1/n);
                pb[i] = -alphap[i]*pc;
            }
            operator==(pb);
        #};
    }
    outlet
    {
        type            codedFixedValue;
        value           uniform -4995;
        name            airPressureZeroOutlet;

        code
        #{
            // p (mixture) = p_air - alpha*pc(alpha), with p_air = 0
            const fvPatchScalarField& alphap =
                patch().lookupPatchField<volScalarField, scalar>("alpha.wetting");

            const dictionary& tp =
                db().lookupObject<IOdictionary>("transportProperties");
            const dictionary& vg = tp.subDict("VanGenuchtenCoeffs");

            const scalar act  = readScalar(tp.lookup("activateCapillarity"));
            const scalar pc0  = dimensionedScalar(vg.lookup("pc0")).value();
            const scalar m    = readScalar(vg.lookup("m"));
            const scalar Smin =
                dimensionedScalar(vg.lookup("alpha.wettingminpc")).value();
            const scalar Smax =
                dimensionedScalar(vg.lookup("alpha.wettingmaxpc")).value();
            const scalar n    = 1/(1 - m);

            scalarField pb(alphap.size());
            forAll(pb, i)
            {
                const scalar Se =
                    min(max((alphap[i] - Smin)/(Smax - Smin), 1e-4), 1 - 1e-4);
                const scalar pc = act*pc0*pow(pow(Se, -1/m) - 1, 1/n);
                pb[i] = -alphap[i]*pc;
            }
            operator==(pb);
        #};
    }
    sides
    {
        type            symmetry;
    }
}

