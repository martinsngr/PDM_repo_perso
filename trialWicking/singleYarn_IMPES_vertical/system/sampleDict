type sets;
libs ("libsampling.so");

interpolationScheme cellPoint; 

setFormat gnuplot;

surfaceFormat   vtk;

#include "../caseSetup"

sets
(
    alongYarn
    {
        type    midPoint;
        axis    x;
        start   ($xmin 0 0);
        end     ($xmax 0 0);
    }
);

surfaces        ();

fields          ( Sb );

