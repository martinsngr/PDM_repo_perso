FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    left
    {
        type            fixedValue;
        value           uniform 0;
    }

    right
    {
        type            darcyGradPressure;
        value           uniform 0;
    }

    yarn_to_fluid
    {
        type            fixedValue;
        value           uniform 0;
    }

    // Full-mesh patches, only read by splitMeshRegions (not in the yarn mesh)
    "(inlet|outlet)"
    {
        type            zeroGradient;
    }

    "(top|bottom)"
    {
        type            symmetry;
    }
}

