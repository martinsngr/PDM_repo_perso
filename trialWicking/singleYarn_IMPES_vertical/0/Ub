FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ub;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    right
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    yarn_to_fluid
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Full-mesh patches, only read by splitMeshRegions (not in the yarn mesh)
    "(inlet|outlet)"
    {
        type            zeroGradient;
    }

    "(top|bottom)"
    {
        type            symmetry;
    }
}

