FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

// p is the air pressure (phase a). Air is at 0 Pa at the reservoir and at the
// open top, as in ../1D_vertical_impes_inletRes. The lateral surface is closed,
// as in ../singleYarn_vertical_hybrid.
internalField   uniform 0;

boundaryField
{
    // reservoir (x-min): air at 0 Pa, water at -pc(0.99) = -676 Pa
    left
    {
        type            fixedValue;
        value           uniform 0;
    }

    // open top (x-max): air leaves freely (Ub fixed 0 keeps the liquid in)
    right
    {
        type            fixedValue;
        value           uniform 0;
    }

    // lateral surface closed to both phases (Ua, Ub fixed 0): the gradient is
    // set so that the total flux, gravity and capillary parts included, is
    // zero (the patch flux phi, zero from the start). zeroGradient would still
    // let the gravity flux through the wall faces that are not parallel to x.
    yarn_to_fluid
    {
        type            darcyGradPressure;
        value           uniform 0;
    }
}

