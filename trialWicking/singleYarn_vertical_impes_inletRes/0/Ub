FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ub;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    // no liquid leaves through the top or the (closed) lateral surface
    "(right|yarn_to_fluid)"
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}

