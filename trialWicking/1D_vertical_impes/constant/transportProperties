FoamFile
{
  version     2.0;
  format      ascii;
  class       dictionary;
  location    "constant";
  object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

activateCapillarity	1;

// Hold the bottom 2 cm (cellZone "bottomReservoir", built by topoSet from
// system/topoSetDict) at Sb=0.99 for the whole run, representing a
// permanently saturated reservoir feeding the wicking column. 0.99 rather
// than Sbmax (0.999): the Van Genuchten capillary pressure derivative is
// singular at Sb=Sbmax, so clamping exactly there crashes the solver.
fixedSb
{
    active      true;
    zoneName    bottomReservoir;
    value       0.99;
}

eps		eps [0  0  0 0 0 0 0]	0.5;

phase.a
{
    rho	rho [1 -3 0 0 0 0 0] 	1e0;
    mu	mu [1 -1 -1 0 0 0 0]	1.76e-5;
}
	
phase.b
{
    rho	rho [1 -3 0 0 0 0 0] 	1e3;
    mu	mu [1 -1 -1 0 0 0 0]	1e-3;
}

relativePermeabilityModel  BrooksAndCorey;

BrooksAndCoreyCoeffs
{
    n 3; 	
    Sbmin 0;
    Sbmax 0.999;
}

capillarityModel	VanGenuchten;

VanGenuchtenCoeffs
{
    pc0 5000;
    m 0.5;	
    Sbmin 0;
    Sbmax 0.999;	
}

