From b93e429b7f72cebec2e9d66a6c5e27c68439bcda Mon Sep 17 00:00:00 2001
From: martinsngr <martin.sinegre@gmail.com>
Date: Thu, 1 Oct 2026 12:00:01 +0200
Subject: [PATCH 3/5] C: upwind kr in porous faces by the phase Darcy flux
 direction

kr1f/kr2f in porous faces (Solidf = 1) are taken from the upstream cell of
each phase's Darcy flux of the last alphaEqn (phiWettingUp/phiNonWettingUp),
as impesFoam (kra upwind phia, krb upwind phib). Linear interpolation halved
the water mobility at the wet/dry face and slowed the front (bench 0.2 ms:
leading edge 0.134/0.076 -> 0.184/0.130, impesFoam 0.208/0.146).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hybridPorousInterFoam/alphaEqn.H                | 2 ++
 hybridPorousInterFoam/createPorousMediaFields.H | 5 +++++
 hybridPorousInterFoam/updateVariables.H         | 9 +++++++++
 3 files changed, 16 insertions(+)

diff --git a/hybridPorousInterFoam/alphaEqn.H b/hybridPorousInterFoam/alphaEqn.H
index 2c80e27..6cc9dbd 100644
--- a/hybridPorousInterFoam/alphaEqn.H
+++ b/hybridPorousInterFoam/alphaEqn.H
@@ -116,6 +116,8 @@
           - phiNonWetting/max(1. - alpha1f, scalar(0.001))
         )/fvc::interpolate(eps)
     );
+    phiWettingUp = phiWetting;
+    phiNonWettingUp = phiNonWetting;
 
     //surfaceScalarField::Boundary& phicBf =
     //phic.boundaryFieldRef();
diff --git a/hybridPorousInterFoam/createPorousMediaFields.H b/hybridPorousInterFoam/createPorousMediaFields.H
index 985a115..1b28597 100644
--- a/hybridPorousInterFoam/createPorousMediaFields.H
+++ b/hybridPorousInterFoam/createPorousMediaFields.H
@@ -16,6 +16,11 @@ volScalarField K
 volScalarField k0("k0", K); 
 surfaceScalarField k0f("k0f",fvc::interpolate(k0,"k0"));
 
+// Phase Darcy fluxes of the last alphaEqn.H, kept to upwind kr in porous
+// faces (updateVariables.H); zero before the first step
+surfaceScalarField phiWettingUp("phiWettingUp", 0*phi);
+surfaceScalarField phiNonWettingUp("phiNonWettingUp", 0*phi);
+
 autoPtr<relativePermeabilityModel> krModel = relativePermeabilityModel::New("krModel",transportProperties,alpha1);
 krModel->correct(); 
 volScalarField kr1 = krModel->krb();
diff --git a/hybridPorousInterFoam/updateVariables.H b/hybridPorousInterFoam/updateVariables.H
index 01b0333..a3f1280 100755
--- a/hybridPorousInterFoam/updateVariables.H
+++ b/hybridPorousInterFoam/updateVariables.H
@@ -7,6 +7,15 @@ kr2=krModel->kra();
 kr1f = fvc::interpolate(kr1,"kr1");
 kr2f = fvc::interpolate(kr2,"kr2");
 
+// Porous faces: kr of the upstream cell of each phase's Darcy flux (last
+// alphaEqn.H), as impesFoam (kra upwind phia, krb upwind phib). Linear
+// interpolation halves the water mobility of the face between a wet and a
+// dry cell and slows the front.
+kr1f = (1. - Solidf)*kr1f
+  + Solidf*upwind<scalar>(mesh, phiWettingUp).interpolate(kr1);
+kr2f = (1. - Solidf)*kr2f
+  + Solidf*upwind<scalar>(mesh, phiNonWettingUp).interpolate(kr2);
+
 // Updating Mobilities
 M1 = k0*kr1/mu1;
 L1 = rho1*k0*kr1/mu1; 	
