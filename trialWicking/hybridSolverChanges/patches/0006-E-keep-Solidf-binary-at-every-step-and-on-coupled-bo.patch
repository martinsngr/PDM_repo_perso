From c3a2e6e9bbdf513fbd864d2737e654d149f34070 Mon Sep 17 00:00:00 2001
From: martinsngr <martin.sinegre@gmail.com>
Date: Mon, 12 Oct 2026 11:02:35 +0200
Subject: [PATCH] E: keep Solidf binary at every step and on coupled boundary
 faces

Solidf marks porous faces: 1 between two porous cells, 0 otherwise.
createPorousMediaFields.H builds it with interpolate(Solid) and clips values
below 1 to 0, but updateDarcyVelocities.H (called at the start of every
alpha equation) recomputes Solidf = interpolate(Solid) without the clipping
(upstream, since 98e48b9 "added dynamic mesh capability"). From the first
time step every porous/free face had Solidf = 0.5. The start-up clipping
also skipped boundary faces, where interpolate averages the two sides of
coupled patches (processor, cyclic).

With Solidf = 0.5 the porous terms (phase Darcy fluxes and relative flux in
alphaEqn.H, capillary terms in UEqn.H/pEqn.H, upwinded kr) were half-active
on porous/free faces, with K interpolated between the porous and the free
cell (0.5 m2 for K = 1 m2 in free cells) and the capillary pressure of the
free cell (Van Genuchten of a dry free cell: MPa). On a 2D bench (porous
slab between free layers, K 1e-11, VG pc0 5000 Pa m 0.5) the relative flux
on porous/free faces was 1.6e4 (1e-26 on porous faces) and wet porous cells
next to free cells emptied into them in one time step; p then reached
1e15 Pa and dt collapsed to 1e-16 s.

New binarySolidf.H clips Solidf to 0/1 on internal and boundary faces; it is
included after both interpolate(Solid) calls (start-up and every step).

Checks: bit-identical to b995db5 without free cells (1D wicking column to
0.1 s, all-porous 2D bench to 0.2 ms). With free cells the first-step
failure is gone. On 2 processors with the processor boundary on the
porous/free faces, clipping internal faces only still fails there; with
this change the run matches the serial one (alpha within 3e-6). A second,
slower failure at wet porous/free interfaces remains (separate issue).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hybridPorousInterFoam/binarySolidf.H          | 33 +++++++++++++++++++
 .../createPorousMediaFields.H                 |  8 +----
 hybridPorousInterFoam/updateDarcyVelocities.H |  3 ++
 3 files changed, 37 insertions(+), 7 deletions(-)
 create mode 100644 OpenFoamV8/solvers/hybridPorousInterFoam/binarySolidf.H

diff --git a/hybridPorousInterFoam/binarySolidf.H b/hybridPorousInterFoam/binarySolidf.H
new file mode 100644
index 0000000..f97105d
--- /dev/null
+++ b/hybridPorousInterFoam/binarySolidf.H
@@ -0,0 +1,33 @@
+// Binary face indicator of the porous medium, applied after every
+// Solidf = fvc::interpolate(Solid):
+//     Solidf = 1 on a face between two porous cells (Solid = 1 on both sides),
+//     Solidf = 0 otherwise (free/free and porous/free faces).
+// interpolate() gives 0.5 on a porous/free face. Every term weighted by Solidf
+// (porous phase fluxes and relative flux in alphaEqn.H, capillary term in
+// UEqn.H and pEqn.H, upwinded kr in updateVariables.H) would then use, on that
+// face, the porous closures with a permeability interpolated between the
+// porous and the free cell and the capillary pressure of the free cell, i.e.
+// a meaningless flux (it emptied wet porous cells next to free cells in one
+// time step). Coupled boundary faces (processor, cyclic) are averaged in the
+// same way and are clipped as well; on other boundary faces Solidf is the
+// patch value of Solid, already 0 or 1.
+forAll(Solidf, facei)
+{
+    if (Solidf[facei] < 1)
+    {
+        Solidf[facei] = 0;
+    }
+}
+
+forAll(Solidf.boundaryField(), patchi)
+{
+    fvsPatchScalarField& Solidfp = Solidf.boundaryFieldRef()[patchi];
+
+    forAll(Solidfp, facei)
+    {
+        if (Solidfp[facei] < 1)
+        {
+            Solidfp[facei] = 0;
+        }
+    }
+}
diff --git a/hybridPorousInterFoam/createPorousMediaFields.H b/hybridPorousInterFoam/createPorousMediaFields.H
index 0b71838..fe2f237 100644
--- a/hybridPorousInterFoam/createPorousMediaFields.H
+++ b/hybridPorousInterFoam/createPorousMediaFields.H
@@ -98,13 +98,7 @@ forAll(mesh.boundary(), patchi)
 surfaceScalarField Solidf(fvc::interpolate(Solid));
 
 //Eliminating intermediate values of Solid Indicator Function
-forAll(Solidf,facei)
-{
-	if(Solidf[facei]<1) // if <1 ==0.  
-	{	
-	Solidf[facei]=0; 
-	}
-}
+#include "binarySolidf.H"
 
 // Faces where pEqn.H computes the total flux as a Darcy flux (DarcyFace = 1):
 // porous faces (Solidf = 1) whose Darcy number K_f/dx^2 is below
diff --git a/hybridPorousInterFoam/updateDarcyVelocities.H b/hybridPorousInterFoam/updateDarcyVelocities.H
index 92ee614..81f38a6 100644
--- a/hybridPorousInterFoam/updateDarcyVelocities.H
+++ b/hybridPorousInterFoam/updateDarcyVelocities.H
@@ -16,6 +16,9 @@ UnonWetting = Solid*M2*(
 Uwetting.correctBoundaryConditions();
 UnonWetting.correctBoundaryConditions();
 Solidf = fvc::interpolate(Solid);
+// Keep Solidf binary as at start-up (createPorousMediaFields.H): this
+// recomputation (added for dynamic meshes) left 0.5 on porous/free faces
+#include "binarySolidf.H"
 
 
 
