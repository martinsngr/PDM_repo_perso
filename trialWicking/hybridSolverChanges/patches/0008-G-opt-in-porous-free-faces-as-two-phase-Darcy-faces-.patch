             //Alternative flux formulation (better porous contact angle results
             //but no fancy (i.e. PLIC) interface compression schemes.
             //(fvc::flux
diff --git a/hybridPorousInterFoam/createPorousMediaFields.H b/hybridPorousInterFoam/createPorousMediaFields.H
index cf5c79e..fbaa946 100644
--- a/hybridPorousInterFoam/createPorousMediaFields.H
+++ b/hybridPorousInterFoam/createPorousMediaFields.H
@@ -100,6 +100,64 @@ surfaceScalarField Solidf(fvc::interpolate(Solid));
 //Eliminating intermediate values of Solid Indicator Function
 #include "binarySolidf.H"
 
+// Change G (opt-in): porous/free faces carry the porous two-phase fluxes,
+// with pc = 0 in free cells and the harmonic face permeability (see
+// porousFace.H). Without the keyword porousFace = Solidf: solver unchanged.
+const Switch porousFreeDarcyFaces
+(
+    transportProperties.lookupOrDefault<Switch>("porousFreeDarcyFaces", false)
+);
+surfaceScalarField porousFace("porousFace", Solidf);
+#include "porousFace.H"
+// porous/free faces; a face on a coupled patch is seen from both sides and
+// counts 1/2 on each
+scalar nPorousFreeFaces = 0;
+if (porousFreeDarcyFaces)
+{
+    // Harmonic permeability on porous/free faces: resistance of the porous
+    // half cell plus the (negligible) free half cell. Linear interpolation
+    // would give (K_porous + K_free)/2, i.e. the free-cell value.
+    const surfaceScalarField& w = mesh.weights();
+    const labelUList& own = mesh.owner();
+    const labelUList& nei = mesh.neighbour();
+    forAll(k0f, facei)
+    {
+        if (porousFace[facei] > 0.5 && Solidf[facei] < 0.5)
+        {
+            k0f[facei] =
+                1/(w[facei]/k0[own[facei]] + (1 - w[facei])/k0[nei[facei]]);
+            nPorousFreeFaces++;
+        }
+    }
+    forAll(k0f.boundaryField(), patchi)
+    {
+        const fvPatchScalarField& k0p = k0.boundaryField()[patchi];
+        if (k0p.coupled())
+        {
+            fvsPatchScalarField& k0fp = k0f.boundaryFieldRef()[patchi];
+            const scalarField k0i(k0p.patchInternalField());
+            const scalarField k0n(k0p.patchNeighbourField());
+            const scalarField& wp = w.boundaryField()[patchi];
+            forAll(k0fp, facei)
+            {
+                if
+                (
+                    porousFace.boundaryField()[patchi][facei] > 0.5
+                 && Solidf.boundaryField()[patchi][facei] < 0.5
+                )
+                {
+                    k0fp[facei] =
+                        1/(wp[facei]/k0i[facei] + (1 - wp[facei])/k0n[facei]);
+                    nPorousFreeFaces += 0.5;
+                }
+            }
+        }
+    }
+    reduce(nPorousFreeFaces, sumOp<scalar>());
+    Info<< "porousFreeDarcyFaces: " << round(nPorousFreeFaces)
+        << " porous/free faces carry the porous two-phase fluxes" << endl;
+}
+
 // Faces where pEqn.H computes the total flux as a Darcy flux (DarcyFace = 1):
 // porous faces (Solidf = 1) whose Darcy number K_f/dx^2 is below
 // darcyFaceMaxDa (transportProperties). There inertia and the Brinkman
@@ -117,7 +175,7 @@ surfaceScalarField DarcyFace("DarcyFace", 0*Solidf);
     const surfaceScalarField Daf(k0f*sqr(mesh.deltaCoeffs()));
     forAll(DarcyFace, facei)
     {
-        if (Solidf[facei] > 1 - small && Daf[facei] < darcyFaceMaxDa)
+        if (porousFace[facei] > 1 - small && Daf[facei] < darcyFaceMaxDa)
         {
             DarcyFace[facei] = 1;
         }
@@ -135,7 +193,7 @@ surfaceScalarField DarcyFace("DarcyFace", 0*Solidf);
         {
             if
             (
-                Solidf.boundaryField()[patchi][facei] > 1 - small
+                porousFace.boundaryField()[patchi][facei] > 1 - small
              && f*Daf.boundaryField()[patchi][facei] < darcyFaceMaxDa
             )
             {
@@ -195,7 +253,68 @@ volScalarField DarcyCell("DarcyCell", Solid);
     }
 }
 
+// Change G: porous/free faces that are not Darcy faces (K_f/dx^2 above
+// darcyFaceMaxDa) fall back to the momentum path with an interpolated
+// capillary term, i.e. without the consistent phase-pressure coupling of G
+if (porousFreeDarcyFaces)
+{
+    scalar nNonDarcy = 0;
+    forAll(DarcyFace, facei)
+    {
+        if
+        (
+            porousFace[facei] > 0.5 && Solidf[facei] < 0.5
+         && DarcyFace[facei] < 0.5
+        )
+        {
+            nNonDarcy++;
+        }
+    }
+    forAll(DarcyFace.boundaryField(), patchi)
+    {
+        if (DarcyFace.boundaryField()[patchi].coupled())
+        {
+            forAll(DarcyFace.boundaryField()[patchi], facei)
+            {
+                if
+                (
+                    porousFace.boundaryField()[patchi][facei] > 0.5
+                 && Solidf.boundaryField()[patchi][facei] < 0.5
+                 && DarcyFace.boundaryField()[patchi][facei] < 0.5
+                )
+                {
+                    nNonDarcy += 0.5;
+                }
+            }
+        }
+    }
+    reduce(nNonDarcy, sumOp<scalar>());
+    if (nNonDarcy > 0)
+    {
+        WarningInFunction
+            << round(nNonDarcy) << " of " << round(nPorousFreeFaces)
+            << " porous/free faces are not Darcy faces (K_f*deltaCoeffs^2 >= "
+            << "darcyFaceMaxDa " << darcyFaceMaxDa << "): there the "
+            << "porousFreeDarcyFaces coupling does not apply. Increase "
+            << "darcyFaceMaxDa or check K and the mesh." << endl;
+    }
+    else
+    {
+        Info<< "porousFreeDarcyFaces: all " << round(nPorousFreeFaces)
+            << " porous/free faces are Darcy faces" << endl;
+    }
+}
+
 //Label for mesh refinement (we only want to refine at
 //the fluid-fluid interface in solid-free region
 volScalarField gradSolid ("gradSolid",mag(fvc::grad(Solid)));
 volScalarField meshingIndicator("meshingIndicator", alpha1*(1-10*Solid));
+
+// Change G: mobilities, kr and pc above were built before Solid and the
+// porous/free faces were known; recompute them once (pc = 0 in free cells).
+// Only if there are porous/free faces: without them the start-up state is
+// left exactly as without G.
+if (porousFreeDarcyFaces && nPorousFreeFaces > 0)
+{
+    #include "updateVariables.H"
+}
diff --git a/hybridPorousInterFoam/porousFace.H b/hybridPorousInterFoam/porousFace.H
new file mode 100644
index 0000000..848484e
--- /dev/null
+++ b/hybridPorousInterFoam/porousFace.H
@@ -0,0 +1,26 @@
+// porousFace: faces on which the porous two-phase (Darcy) terms are used:
+// phase Darcy fluxes and relative flux (alphaEqn.H), upwinded kr
+// (updateVariables.H) and the Darcy-face selection (createPorousMediaFields.H).
+// Without porousFreeDarcyFaces: porousFace = Solidf (both sides porous).
+// With porousFreeDarcyFaces (change G): also porous/free faces (at least one
+// side porous). There the free cell has pc = 0 (updateVariables.H), so the
+// phase fluxes are driven by the differences of the phase pressures
+// (p_air = p + alpha*pc, p_water = p - (1 - alpha)*pc), which are continuous
+// across the face: air pressure for a dry free cell, water pressure for a wet
+// one (capillary pressure jump at the porous surface).
+porousFace = fvc::interpolate(Solid);
+{
+    const scalar threshold = porousFreeDarcyFaces ? small : 1 - small;
+    forAll(porousFace, facei)
+    {
+        porousFace[facei] = porousFace[facei] > threshold ? 1 : 0;
+    }
+    forAll(porousFace.boundaryField(), patchi)
+    {
+        fvsPatchScalarField& pfp = porousFace.boundaryFieldRef()[patchi];
+        forAll(pfp, facei)
+        {
+            pfp[facei] = pfp[facei] > threshold ? 1 : 0;
+        }
+    }
+}
diff --git a/hybridPorousInterFoam/updateDarcyVelocities.H b/hybridPorousInterFoam/updateDarcyVelocities.H
index 81f38a6..8c8c02b 100644
--- a/hybridPorousInterFoam/updateDarcyVelocities.H
+++ b/hybridPorousInterFoam/updateDarcyVelocities.H
@@ -19,6 +19,7 @@ Solidf = fvc::interpolate(Solid);
 // Keep Solidf binary as at start-up (createPorousMediaFields.H): this
 // recomputation (added for dynamic meshes) left 0.5 on porous/free faces
 #include "binarySolidf.H"
+#include "porousFace.H"
 
 
 
diff --git a/hybridPorousInterFoam/updateVariables.H b/hybridPorousInterFoam/updateVariables.H
index 2668273..4cc81d7 100755
--- a/hybridPorousInterFoam/updateVariables.H
+++ b/hybridPorousInterFoam/updateVariables.H
@@ -16,10 +16,10 @@ const surfaceScalarField MfLinear(k0f*(kr1f/mu1 + kr2f/mu2));
 // alphaEqn.H), as impesFoam (kra upwind phia, krb upwind phib). Linear
 // interpolation halves the water mobility of the face between a wet and a
 // dry cell and slows the front.
-kr1f = (1. - Solidf)*kr1f
-  + Solidf*upwind<scalar>(mesh, phiWettingUp).interpolate(kr1);
-kr2f = (1. - Solidf)*kr2f
-  + Solidf*upwind<scalar>(mesh, phiNonWettingUp).interpolate(kr2);
+kr1f = (1. - porousFace)*kr1f
+  + porousFace*upwind<scalar>(mesh, phiWettingUp).interpolate(kr1);
+kr2f = (1. - porousFace)*kr2f
+  + porousFace*upwind<scalar>(mesh, phiNonWettingUp).interpolate(kr2);
 
 // Updating Mobilities
 M1 = k0*kr1/mu1;
@@ -45,6 +45,13 @@ autoPtr<capillarityModel> myCapModel = capillarityModel::New("pc",transportPrope
 myCapModel().correct();
 pc = myCapModel().pc()*activateCapillarity; 
 dPcdS = myCapModel().dpcdS()*activateCapillarity; 
+// Change G: no capillary pressure in free cells (the porous/free faces then
+// carry the capillary pressure jump of the porous side only)
+if (porousFreeDarcyFaces)
+{
+    pc *= Solid;
+    dPcdS *= Solid;
+}
 PcCoeff = (  
 	-pc
 	+(1./M)*(M1*(1.-alpha1) - M2*(alpha1))*dPcdS
