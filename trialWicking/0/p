FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    inlet
    {
        type	        fixedValue;
	value		uniform 0;
    }

    outlet
    {
	// open top: air leaves freely (Ub fixed 0 keeps liquid in)
	type		fixedValue;
	value		uniform 0;
    }

    frontAndBack    
    {
        type            empty;
    }
}

