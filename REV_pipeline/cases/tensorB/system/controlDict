FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hybridPorousInterFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
// tensorB: 60 ms: the front moves x0.65 (K x0.42), job 3068's front at 30 ms is reached at ~71 ms
endTime         0.06;
deltaT          1e-8;
writeControl    adjustableRunTime;
writeInterval   1e-03;  // ~60 MB per write (242k cells, ascii) + the tensor K (~20 MB)
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   12;
runTimeModifiable yes;

// Time step: solver limits on the total flux (free cells), then the
// coatsTimeStep function object (porous cells + capillary waves) overwrites
// maxDeltaT every step; setDeltaT.H grows dt by at most 1.2x per step.
// Values as ../../trialWicking/singleYarn_vertical_hybrid.
adjustTimeStep  yes;
maxCo           0.75;
maxAlphaCo      1;
maxDeltaT       3e-8;   // first-step cap only
CoatsMaxCo      0.5;
dSmax           0.01;
maxDeltaTCoats  1e-3;
minDeltaTCoats  0;
CapillaryMaxCo  0.5;

// Stop guard (../../../tools/stopGuard): write and end after maxSteps steps
// (-1: no limit) or when deltaT < minDeltaTStop (collapsed time step).
maxSteps        -1;
minDeltaTStop   1e-14;

functions
{
    coatsTimeStep { #include "../../../tools/coatsTimeStep" }
    liquidBalance { #include "../../../tools/liquidBalance" }
    stopGuard     { #include "../../../tools/stopGuard" }
    waterBudget   { #include "../../../tools/waterBudget" }
}

