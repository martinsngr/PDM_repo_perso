FoamFile
{
    version     2.0;
    format      ascii;
    class       uniformDimensionedVectorField;
    location    "constant";
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// No gravity: anisoImpesFoam's gravity-aware wall BC (darcyGradPressureAniso) looks g up in the Time registry
// and stops on OpenFOAM 9 (verification/tensorK, check 4); the yarn surfaces are symmetry patches instead, exact
// (zero flux) only without gravity. tensorA has gravity along -y: over its 2.7 mm, rho g L = 26 Pa against pc0
// 5000 Pa, about 1 % of the capillary drive (estimate).

dimensions      [0 1 -2 0 0 0 0];
value           (0 0 0);

