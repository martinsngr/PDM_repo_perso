FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// The yarn (porous) cells of tensorA's mesh: eps <= 0.99, the porous test of hybridPorousInterFoam.

actions
(
    {
        name    porous;
        type    cellSet;
        action  new;
        source  fieldToCell;
        sourceInfo
        {
            field   eps;
            min     -1;
            max     0.99;
        }
    }
);

