FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// As ../../../verification/tensorK/C4_aniso_impes: K linear (harmonic exists for scalars only), interpolation
// default linear (the tensor Laplacian interpolates grad(p) for its cross term, zero for a diagonal K on this mesh).

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
    K               linear;
    pc              linear;
    kra             upwind phia;
    krb             upwind phib;
    flux(U)         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    p               ;
}

