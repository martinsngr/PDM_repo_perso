FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// p: GAMG instead of check 4's PCG (78k cells instead of 3,200; the solution differs only within the tolerance).

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
    Sb
    {
        solver          no_solver_required;
    }
}

