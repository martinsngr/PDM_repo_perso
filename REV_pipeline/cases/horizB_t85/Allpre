#!/bin/bash
cd "${0%/*}" || exit 1
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# horizB_t85 (REV_pipeline, ../../README.md): the horizontal case (the previous student's set-up with our model: the fabric
# lying flat on a bath at rest, water rising through the thickness (z), gravity along -z) with two changes: K from Gebart
# (tensor, hex, Vf 0.5, fibre radius 7.5 um: Kpar 4.245e-12, Kperp 9.20e-13 m2, as tensorB) and theta 85 deg (weak wetting);
# twin case horizB_t40 (theta 40 deg). Otherwise REV values (Van Genuchten pc0 5000 Pa, m 0.5; G + H + F' + I, J, L).
# From the TexGen geometry to the initial fields; overwrites the mesh and 0/; then ./run. Python: $PY, else the
# repo .venv (numpy, trimesh, rtree; embreex for speed).
#
#   geometry   ../../geometry/Textiles/PW-22-15-0.4-0.5.stl; REV box ../../geometry/rev_domain.json (inspect_stl.py: x 0-1.818,
#              y 0-2.667, z -0.0705-0.2115 mm; exactly periodic in x and y)
#   mesh       uniform 20 um hex mesh (../../tools/build_fields.py --wick-axis z --zpad 5): the REV box (91 x 133 x 14
#              cells) + 5 free layers below (the bath, 0.1 mm) and 5 above (air). Patches: sideA/sideB cyclic in x,
#              frontA/frontB cyclic in y, inlet = bottom face of the bath rows (water only, J), top = open to air
#   fields     eps, K (Gebart), fYarn, yarnID; alpha.wetting by ../../tools/initFields.py:
#              the 5 bath rows water (--free-fill 1e-4: cell centres within 0.1 mm of the inlet), gaps air, yarns
#              0.002 except a wet contact zone: the yarn cells of the bottom four fabric layers on a ramp, S 0.84 / 0.64 /
#              0.35 / 0.15 (--sat-height 1e-4 --ramp 8e-5: the ramp starts at the bath surface, 0.1 mm above the inlet),
#              +6.3 % of the yarn capacity (~4 g/m2). Adopted 2026-11-09 (user) after verification/study2f_horizontalAir: a
#              dry yarn cell touching bath water gets the Van Genuchten dry-end pc (2.5 MPa at S 0.002) across one face and
#              the run fails at 31 us; with the wet contact zone it runs to 0.5 ms (R3b, unchanged solver). Same treatment as
#              the bath of the vertical cases: the first instants of contact are not resolved
#   BCs        0.orig: inlet = bath at rest (totalPressure rho g 5 dz, water at 0 Pa at the bath surface), top = air
#              at rest (totalPressure 0); x and y cyclic

PY=${PY:-../../../.venv/bin/python}
[ -x "$PY" ] || PY=python3

./clean
rm -rf constant/polyMesh 0 system/blockMeshDict
cp -r 0.orig 0
rm -f log.blockMesh log.checkMesh log.build_fields log.postProcess.writeCellCentres log.initFields

"$PY" ../../tools/build_fields.py . --stl ../../geometry/Textiles/PW-22-15-0.4-0.5.stl --domain ../../geometry/rev_domain.json \
    --k-mode tensor --cut-cells binary --wick-axis z --zpad 5 \
    > log.build_fields 2>&1 || { cat log.build_fields; exit 1; }
runApplication blockMesh
runApplication checkMesh
runApplication -s writeCellCentres postProcess -func writeCellCentres -time 0
"$PY" ../../tools/initFields.py --free-fill 1e-4 --sat-height 1e-4 --ramp 8e-5 \
    > log.initFields 2>&1 || { cat log.initFields; exit 1; }
cat log.initFields
rm -f 0/C 0/Cx 0/Cy 0/Cz
